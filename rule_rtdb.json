{
  "rules": {
    ".read": false,
    ".write": false,
    "app_errors": {
      // Mengizinkan pengguna yang sudah login untuk mencatat dan memantau log error
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "seller_sphere": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "shopId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "$other": {
          ".validate": "true"
        }
      }
    },
    "shop_sphere": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "matrix_members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth.token.isAdmin === true"
      }
    },
    "approval": {
      ".read": "auth.token.isAdmin === true",
      ".write": "auth.token.isAdmin === true"
    },
    "system": {
      ".read": "auth.token.isAdmin === true",
      ".write": "auth.token.isAdmin === true"
    },
    "shops": {
      "$shopId": {
        ".read": "auth != null && data.child('ownerUid').val() == auth.uid",
        ".write": "auth != null && data.child('ownerUid').val() == auth.uid",
        "ownerUid": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "shopName": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "pickupAddress": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "pickupCoordinates": {
          ".validate": "newData.hasChildren(['latitude', 'longitude'])",
          "latitude": {
            ".validate": "newData.isNumber()"
          },
          "longitude": {
            ".validate": "newData.isNumber()"
          }
        },
        "$other": {
          ".validate": "true"
        }
      }
    },
    "shops_pending_approval": {
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".read": false,
        "ownerUid": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "shopName": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "pickupAddress": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "pickupCoordinates": {
          ".validate": "newData.hasChildren(['latitude', 'longitude'])",
          "latitude": {
            ".validate": "newData.isNumber()"
          },
          "longitude": {
            ".validate": "newData.isNumber()"
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.isString() && newData.val() == 'pending'"
        },
        "$other": {
          ".validate": "true"
        }
      }
    },
    "products": {
      "$productId": {
        ".read": "auth != null",
        ".write": "auth != null && (
          (!data.exists() && root.child('shops').child(newData.child('shopId').val()).child('ownerUid').val() == auth.uid) ||
          (data.exists() && root.child('shops').child(data.child('shopId').val()).child('ownerUid').val() == auth.uid)
        )",
        "shopId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "description": {
          ".validate": "newData.isString()"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "stock": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "sellingPrice": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "soldCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": "true"
        }
      }
    },
    "orders": {
      "$orderId": {
        ".read": "auth != null && (data.child('buyerId').val() == auth.uid || root.child('shops').child(data.child('shopId').val()).child('ownerUid').val() == auth.uid)",
        ".write": "auth != null && root.child('shops').child(newData.child('shopId').val()).child('ownerUid').val() == auth.uid",
        "shopId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "buyerId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "items": {
          ".validate": "newData.hasChildren()"
        },
        "totalAmount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'completed' || newData.val() == 'cancelled')"
        },
        "$other": {
          ".validate": "true"
        }
      }
    },
    "stock_logs": {
      "$productId": {
        "$logId": {
          ".read": "auth != null && root.child('shops').child(root.child('products').child($productId).child('shopId').val()).child('ownerUid').val() == auth.uid",
          ".write": "auth != null && root.child('shops').child(root.child('products').child($productId).child('shopId').val()).child('ownerUid').val() == auth.uid",
          "previousStock": {
            ".validate": "newData.isNumber()"
          },
          "newStock": {
            ".validate": "newData.isNumber()"
          },
          "change": {
            ".validate": "newData.isNumber()"
          },
          "reason": {
            ".validate": "newData.isString()"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": "true"
          }
        }
      }
    },
    "company_profile": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.admin === true || auth.uid === 'mjS1Y9Ll3JRQCMGSTK2oIBVIHT22')"
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        // Pengguna biasa hanya boleh mengubah data miliknya sendiri, 
        // TETAPI Admin utama (berdasarkan UID atau Email) berhak mengubah data siapa saja (termasuk jabatan pekerja)
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true || auth.uid === 'mjS1Y9Ll3JRQCMGSTK2oIBVIHT22')"
      }
    }
  }
}