{
  "rules": {
    ".read": false,
    ".write": false,

    "seller_sphere": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "shop_sphere": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "matrix_members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth.token.isAdmin === true"
      }
    },

    "approval": {
      ".read": "auth.token.isAdmin === true",
      ".write": "auth.token.isAdmin === true"
    },

    "system": {
      ".read": "auth.token.isAdmin === true",
      ".write": "auth.token.isAdmin === true"
    }
  }
}
